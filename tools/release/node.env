# The Node.js runtime of the payload (docs/plan/07-server-install-update.md section 2): the
# official build from nodejs.org, node-<version>-linux-<cpu>.tar.xz, which build.sh downloads
# once into .dev/cache/node/ and checks against these SHA-256 values before it uses it.
# Sourced by build.sh.
#
# To move to another version, set NODE_VERSION and take the values for
# node-<version>-linux-x64.tar.xz (amd64) and node-<version>-linux-arm64.tar.xz (arm64), and for
# the Windows server and the desktop app (docs/plan/18 section 10) node-<version>-win-x64.zip,
# node-<version>-win-arm64.zip, node-<version>-darwin-x64.tar.gz and
# node-<version>-darwin-arm64.tar.gz, from https://nodejs.org/dist/<version>/SHASUMS256.txt. The server bundle targets the same major
# version (apps/server/build.ts).
NODE_VERSION=v26.13.1
NODE_SHA256_AMD64=5c063e46bab0fbc1c17cc445d7ff129cbdcd0471be6ed83b6ab864f8143bc864
NODE_SHA256_ARM64=89e1853138db51e8b82d3e98ba9c0d3f2956a28e5e55ea1b7e12d25aae92d5dd
NODE_SHA256_WINDOWS_AMD64=e2edda75bfb089654705cf65a13b58933bfd5f57148e8ebda916f58a2474f1f7
NODE_SHA256_WINDOWS_ARM64=181ebe431b90787113a9e4fc80d38ce86d37888a353a0386de44d2872e48cb97
NODE_SHA256_MACOS_AMD64=82bb96078a24ca50b9c9a38f2379e6be6d87171fcd400fc14c8934b3bce96e2f
NODE_SHA256_MACOS_ARM64=aec2514ea1ceb2ba52455e9ec65986f6749a06dd759e5db2a72e6889668c9735
