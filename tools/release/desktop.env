# The desktop app's build tools that build.sh downloads (docs/plan/18 sections 9.7 and 10),
# sourced by build.sh. Electron's own version is pinned in apps/desktop/package.json and its
# downloads are checked against apps/desktop/node_modules/electron/checksums.json.
#
# rcodesign (apple-codesign) signs the macOS app ad hoc on Linux: the official release for this
# computer's CPU from
# https://github.com/indygreg/apple-platform-rs/releases/tag/apple-codesign%2F<version>,
# apple-codesign-<version>-<x86_64|aarch64>-unknown-linux-musl.tar.gz, checked against these
# SHA-256 values (each release's .sha256 files) and cached in .dev/cache/rcodesign/.
RCODESIGN_VERSION=0.29.0
RCODESIGN_SHA256_AMD64=dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002
RCODESIGN_SHA256_ARM64=4af92c87ddf52f5f2d1258a3b4e56c7dcb8f1b2468df744976c5f139e031961f
