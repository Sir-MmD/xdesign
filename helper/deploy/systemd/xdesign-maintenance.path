[Unit]
Description=Watch for updates and rollbacks asked for in xDesign's Maintenance

# Maintenance > Update writes the request file last, by an atomic rename; the root
# helper carries it out and deletes it (docs/plan/07-server-install-update.md section 6).
[Path]
PathExists=/var/lib/xdesign/maintenance/request.json
Unit=xdesign-maintenance.service

[Install]
WantedBy=multi-user.target
