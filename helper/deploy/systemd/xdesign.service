[Unit]
Description=xDesign website
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=xdesign
Group=xdesign
ExecStart=/opt/xdesign/current/xdesign serve --config /etc/xdesign/config.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30
KillMode=mixed
StateDirectory=xdesign
StateDirectoryMode=0750
RuntimeDirectory=xdesign
RuntimeDirectoryMode=0750
UMask=0027
SyslogIdentifier=xdesign
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# Privileges: serving HTTPS on 443 (and port 80 for Let's Encrypt) needs this one capability.
# The installer leaves AmbientCapabilities out, and the bounding set empty, when the site
# listens on a port of 1024 or above.
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=yes
LockPersonality=yes

# File system
ProtectSystem=strict
ReadWritePaths=/var/lib/xdesign
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# Kernel interfaces. MemoryDenyWriteExecute is not set: the website's Node.js compiles
# JavaScript to machine code at run time.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
RemoveIPC=yes

# Resources
LimitNOFILE=65536
LimitCORE=0

[Install]
WantedBy=multi-user.target
