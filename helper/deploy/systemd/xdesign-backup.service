[Unit]
Description=xDesign daily backup

[Service]
Type=oneshot
User=xdesign
Group=xdesign
ExecStart=/opt/xdesign/current/xdesign backup --daily --config /etc/xdesign/config.toml
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
UMask=0077
StateDirectory=xdesign
StateDirectoryMode=0750
SyslogIdentifier=xdesign-backup

# The hardening of xdesign.service without its capability and its network: the backup
# reads the data folder and config.toml and writes /var/lib/xdesign/backups.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/xdesign
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
KeyringMode=private
LimitCORE=0
